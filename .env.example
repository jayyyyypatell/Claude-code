# Copy to .env.local and fill in. .env.local is gitignored — this repo is public.

# --- Database ---------------------------------------------------------------
# Local dev: a plain SQLite file. Deployed: a libsql:// Turso URL.
DATABASE_URL="file:./data/life.db"
# DATABASE_AUTH_TOKEN=""

# --- Your timezone ----------------------------------------------------------
# IANA name. Every "per day" figure is bucketed against this, so getting it
# wrong shifts steps and sleep onto neighbouring days.
USER_TIMEZONE="America/New_York"

# --- Health Auto Export ingest ----------------------------------------------
# The bearer token the iOS app sends. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGEST_TOKEN=""

# --- AI coach ---------------------------------------------------------------
# From https://console.anthropic.com
ANTHROPIC_API_KEY=""

# --- Jobs & auth ------------------------------------------------------------
CRON_SECRET=""
# Password for the single-user login. Required before exposing this publicly.
APP_PASSWORD=""
# 32+ chars. Signs the session cookie.
SESSION_SECRET=""

# Set to 1 to persist workout GPS routes (large; nothing renders them yet).
HAE_STORE_ROUTES="0"

# Set to "mock" to develop the coach UI without an API key. It reads your real
# data through the same query layer and returns canned wording — so nothing is
# invented about your health, but no tokens are spent on layout work.
# AI_PROVIDER="mock"
