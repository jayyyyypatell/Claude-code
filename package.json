{
  "name": "lifetracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "test:watch": "vitest",
    "replay": "tsx --env-file=.env.local scripts/replay-fixtures.ts",
    "typecheck": "tsc --noEmit",
    "coach": "tsx --env-file=.env.local scripts/coach-smoke.ts",
    "import": "tsx --env-file=.env.local scripts/import-health-export.ts",
    "gen-export": "node scripts/gen-fake-export.mjs",
    "repair-grain": "tsx --env-file=.env.local scripts/repair-grain.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "@libsql/client": "^0.17.4",
    "drizzle-orm": "^0.45.2",
    "iron-session": "^8.0.4",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "saxes": "^6.0.0",
    "yauzl": "^3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^3.4.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "playwright": "^1.62.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
